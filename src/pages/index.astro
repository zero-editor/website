    <script is:inline>
      // The site's entire JavaScript: ask GitHub what the newest release is,
      // and make the copy buttons copy. If any of it fails, the page has
      // already said everything it needed to.
      (async () => {
        try {
          const r = await fetch('https://api.github.com/repos/zero-editor/zero/releases/latest');
          if (!r.ok) return;
          const rel = await r.json();
          const v = (rel.tag_name || '').replace(/^v/, '');
          const date = rel.published_at
            ? new Date(rel.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
            : '';
          const dmg = (rel.assets || []).find((a) => a.name === 'zero_aarch64.dmg');
          const size = dmg ? `${(dmg.size / 1048576).toFixed(1)}MB` : '';
          const bits = [v && `v${v}`, date, size].filter(Boolean).join(' · ');
          if (!bits) return;
          for (const el of document.querySelectorAll('.release-extra')) {
            el.textContent = ` — ${bits}`;
          }
        } catch {}
      })();

      for (const btn of document.querySelectorAll('.copy')) {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy);
            btn.textContent = 'copied';
            setTimeout(() => (btn.textContent = 'copy'), 1600);
          } catch {}
        });
      }
    </script>
