---
// The whole site is this file. That’s not laziness, it’s a position.
const REPO = 'zero-editor/zero';
const GITHUB = `https://github.com/${REPO}`;
const DMG = `${GITHUB}/releases/latest/download/zero_aarch64.dmg`;
const BENCHMARKS = `${GITHUB}/blob/main/BENCHMARKS.md`;

// Minimal stroke icons, 24-grid. Rendered inline via set:html.
const IC: Record<string, string> = {
  box: '<path d="M12 3 4 7v10l8 4 8-4V7l-8-4Z"/><path d="m4 7 8 4 8-4"/><path d="M12 11v10"/>',
  watch: '<circle cx="12" cy="13" r="8"/><path d="M12 9v4l2.5 2.5"/><path d="M9.5 2.5h5"/>',
  chip: '<rect x="7" y="7" width="10" height="10" rx="1"/><path d="M4 10h3M4 14h3M17 10h3M17 14h3M10 4v3M14 4v3M10 17v3M14 17v3"/>',
  braces: '<path d="M8.5 4C6.5 4 7 6 7 7.5S7 11 5 12c2 1 2 2.5 2 4.5S6.5 20 8.5 20"/><path d="M15.5 4c2 0 1.5 2 1.5 3.5s0 3.5 2 4.5c-2 1-2 2.5-2 4.5s.5 3.5-1.5 3.5"/>',
  gauge: '<path d="M5 19a9 9 0 1 1 14 0"/><path d="m12 14 4.5-4.5"/>',
  tabs: '<rect x="3" y="5" width="18" height="14" rx="2"/><path d="M3 10h18M9 5v5M15 5v5"/>',
  term: '<rect x="3" y="4" width="18" height="16" rx="2"/><path d="m7 9 3 3-3 3"/><path d="M12 15h5"/>',
  branch: '<circle cx="6" cy="6" r="2"/><circle cx="6" cy="18" r="2"/><circle cx="18" cy="7" r="2"/><path d="M6 8v8"/><path d="M18 9c0 5-9 3.5-11 7"/>',
  bars: '<path d="M6 5v14"/><path d="M12 9v10"/><path d="M18 4v9"/>',
  search: '<circle cx="10.5" cy="10.5" r="6.5"/><path d="M15.5 15.5 21 21"/>',
  bolt: '<path d="M13 2 5 13.5h5L9 22l8-11.5h-5z"/>',
  cursor: '<path d="m5 4 13 6.5-5.5 1.5 3.5 5.5-2.5 1.5-3.5-5.5L6 17z"/>',
  restore: '<path d="M4 5v6h6"/><path d="M4.5 11a8 8 0 1 0 2.5-6"/>',
  slash: '<circle cx="12" cy="12" r="9"/><path d="m6 6 12 12"/>',
  ring: '<circle cx="12" cy="12" r="8" opacity="0.18"/><path d="M12 4a8 8 0 1 1-7.39 4.94"/>',
  feather: '<path d="M19.5 4.5c-5.5 0-11 3.5-13 9-1 2.7-1.2 5.3-1.2 7 2 0 4.6-.2 7.2-1.2 5.5-2 9-7.5 8.5-14.8Z"/><path d="m4 20 9.5-9.5"/>',
};

// The GitHub mark, the one link that gets to be a logo.
const OCTO =
  '<path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"/>';

const STATS = [
  { icon: 'box',  x: '61×',  l: 'smaller on disk',                 zv: '14MB',  cv: '860MB',   r: 14 / 860 },
  { icon: 'bolt', x: '21×',  l: 'sooner to a window',              zv: '0.38s', cv: '8.16s',   r: 0.38 / 8.16 },
  { icon: 'chip', x: '7.4×', l: 'lighter with four projects open', zv: '243MB', cv: '1,803MB', r: 243 / 1803 },
];
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>zero — a 14MB code editor</title>
    <meta
      name="description"
      content="A minimal macOS code editor built around running coding agents. 14MB, opens in 0.38s, 243MB with four projects open. press record, ramble, press stop."
    />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" type="image/png" sizes="32x32" />
    <link rel="apple-touch-icon" href="/icon.png" />
    <meta name="theme-color" content="#1f1f1f" />
    <meta property="og:title" content="zero — a 14MB code editor" />
    <meta
      property="og:description"
      content="A minimal macOS code editor built around running coding agents. press record, ramble, press stop."
    />
    <meta property="og:type" content="website" />
    <!-- Swap for the real domain's /icon.png once there is one; og wants absolute URLs. -->
    <meta property="og:image" content={`https://raw.githubusercontent.com/${REPO}/main/src-tauri/icons/128x128%402x.png`} />
    <meta name="twitter:card" content="summary" />
  </head>

  <body>
    <nav aria-label="site">
      <a class="wordmark" href="/">zero</a>
      <a href="#install">install</a>
      <a class="gh" href={GITHUB} aria-label="zero on GitHub">
        <svg viewBox="0 0 16 16" fill="currentColor" set:html={OCTO} />
      </a>
    </nav>

    <header class="hero">
      <svg class="mark" viewBox="278 189 468 636" aria-hidden="true">
        <path
          fill="var(--accent)"
          fill-rule="evenodd"
          d="M 286,507 a 226,310 0 1,0 452,0 a 226,310 0 1,0 -452,0 Z M 354,507 a 158,266 0 1,1 316,0 a 158,266 0 1,1 -316,0 Z"
        ></path>
      </svg>
      <p class="kicker">your code editor is mostly decoration.</p>
      <h1>zero is what’s left.</h1>
      <p class="sub">
        A 14MB macOS code editor built around running coding agents: a terminal that takes the whole
        width, projects as tabs, git worktrees down the side, and an editor for when you actually need
        to read one of your files. That’s it — on purpose. It opens in 0.38s and has never once asked
        about your onboarding journey.
      </p>
      <div class="cta">
        <div class="brew">
          <code>brew install --cask zero-editor/zero/zero</code>
          <button class="copy" data-copy="brew install --cask zero-editor/zero/zero" aria-label="copy the brew command">copy</button>
        </div>
        <p class="cta-alt">
          or <a href={DMG}>download the dmg</a>
          <span class="release-extra"></span>
        </p>
        <p class="cta-alt oss">
          Open source, MIT — <a href={GITHUB}>all 17,593 lines of it on GitHub</a>.
        </p>
      </div>
      <p class="fine">Apple Silicon · macOS 26 · no network code in the app</p>
    </header>

    <section class="stats" aria-label="the numbers">
      {STATS.map((s) => (
        <div class="stat">
          <svg class="ic big" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC[s.icon]} />
          <div class="nx">{s.x}</div>
          <div class="l">{s.l}</div>
          <div class="duo">
            <div class="drow"><span class="track"><i class="fill z" style={`width:${Math.max(s.r * 100, 0)}%`}></i></span><span class="val z">{s.zv}</span></div>
            <div class="drow"><span class="track"><i class="fill c" style="width:100%"></i></span><span class="val c">{s.cv}</span></div>
          </div>
        </div>
      ))}
    </section>
    <p class="stats-fine">
      The bright bar is zero; the long one is Cursor. And twenty-one is measured, not marketing —
      <a href={BENCHMARKS}>method and scripts →</a>
    </p>

    <section id="demo" class="demo">
      <div
        class="window"
        role="img"
        aria-label="zero’s window: projects across the titlebar with rings showing session activity, file tabs below, a sidebar file tree, an editor, and a full-width terminal split in two"
      >
        <div class="titlebar">
          <span class="dot r"></span><span class="dot y"></span><span class="dot g"></span>
          <div class="tabs">
            <span class="tab active"><span class="ring working"></span>zero</span>
            <span class="tab"><span class="ring done"></span>api</span>
            <span class="tab">website</span>
          </div>
        </div>
        <div class="editor-tabs">
          <span class="etab active">smoothTermScroll.ts</span>
          <span class="etab mod">Titlebar.tsx</span>
          <span class="etab">ZERO.md</span>
        </div>
        <div class="body">
          <div class="side">
            <div class="ti"><span class="nm">▾ src</span></div>
            <div class="ti in1"><span class="nm">▾ components</span></div>
            <div class="ti in2 mod"><span class="nm">Titlebar.tsx</span><b>M</b></div>
            <div class="ti in2"><span class="nm">Sidebar.tsx</span></div>
            <div class="ti in1"><span class="nm">▾ lib</span></div>
            <div class="ti in2 mod"><span class="nm">smoothTermScroll.ts</span><b>M</b></div>
            <div class="ti in2 add"><span class="nm">memos.ts</span><b>A</b></div>
            <div class="ti in1"><span class="nm">App.css</span></div>
          </div>
          <div class="edit">
            <div class="cl"><span class="gut mod"></span>// The transform is never cleared to "" — always</div>
            <div class="cl"><span class="gut mod"></span>// translate3d(0,0,0): dropping it destroys the</div>
            <div class="cl"><span class="gut"></span>// composited layer, and the next gesture pays</div>
            <div class="cl"><span class="gut"></span>// 150ms to rasterise a new one.</div>
            <div class="cl"><span class="gut add"></span>screen.style.transform = keepAlive(offset);</div>
          </div>
        </div>
        <div class="term">
          <div class="pane">
            <div class="line"><span class="prompt">zero %</span> claude</div>
            <div class="line dim">✻ Thinking…</div>
            <div class="line dim">  ⎿ Reading smoothTermScroll.ts</div>
          </div>
          <div class="pane">
            <div class="line"><span class="prompt">zero %</span> <span class="cursor">▊</span></div>
          </div>
        </div>
      </div>
      <p class="caption">
        The whole interface: projects across the top, their files one row down, a tree at the side,
        and a terminal that takes the full width. The ring on a project is its session — sweeping
        while something’s working, a closed circle when it’s done and waiting on you. No chrome; the
        buttons only appear when your pointer goes looking for them.
      </p>
    </section>

    <section id="points" class="points">
      <div class="point">
        <svg class="pt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.ring} />
        <div>
          <p class="head">every project, at a glance.</p>
          <p class="plain">
            zero is built for having several things going at once. Each project is a tab, and the ring
            on the tab is that project’s work session — sweeping while something is running, a closed
            circle once it’s finished and waiting on you. One glance across the top of the window and
            you know where everything stands. No window juggling, no “which terminal beeped”.
          </p>
          <p class="tech">
            It reads each shell’s process tree and how long the pty has been silent, once a second.
            Nothing to configure, nothing to integrate — the ring just knows.
          </p>
        </div>
      </div>
      <div class="point">
        <svg class="pt-ic rec" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><circle cx="12" cy="12" r="7"/></svg>
        <div>
          <p class="head">press record, ramble, press stop.</p>
          <p class="plain">
            Talk at your project instead of typing at it. Your Mac writes down what you said, claude
            tidies it into the note you meant, and recording on top of a memo folds the new thoughts
            in. Four minutes of thinking out loud, one document you’d actually show someone.
          </p>
          <p class="tech">
            Transcription is macOS 26’s own, on this Mac. One claude -p pass makes the concise
            version. It’s files all the way down — audio, transcripts, document, all in .zero/memos/ —
            and a ZERO.md of proper nouns keeps “Anthropic” from coming back as “entropic”.
          </p>
        </div>
      </div>
      <div class="point">
        <svg class="pt-ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.feather} />
        <div>
          <p class="head">it’s barely even there.</p>
          <p class="plain">
            14MB on disk. A window in 0.38s. A quarter of a gigabyte with four projects open. Your RAM
            goes to the work, not to the app it runs in — an editor should be a tool, not a tenant.
          </p>
          <p class="tech">
            Numbers below, method in BENCHMARKS.md, scripts in bench/ if you’d like to run them on
            your own machine.
          </p>
        </div>
      </div>
    </section>

    <section id="benchmarks" class="bench">
      <h2>benchmarks</h2>
      <p class="method">
        Same machine, same project, both editors, three launches each, median reported.
        M3&nbsp;Max · 36GB · macOS&nbsp;26.5.1 · Cursor&nbsp;3.15.6. We didn’t have to cherry-pick.
        In every graph: <b class="zl">zero is the bright mark</b>; the long grey one is Cursor.
      </p>

      <div class="bento">
        <div class="bcard">
          <div class="bhead">
            <h4>on disk</h4>
            <span class="badge">61×</span>
          </div>
          <div class="duo">
            <div class="drow"><span class="track"><i class="fill z" style="width:1.63%"></i></span><span class="val z">14MB</span></div>
            <div class="drow"><span class="track"><i class="fill c" style="width:100%"></i></span><span class="val c">860MB</span></div>
          </div>
          <p class="micro">And 5 files in the bundle, against 17,035 — 3,407× fewer things that can be wrong.</p>
        </div>

        <div class="bcard">
          <div class="bhead">
            <h4>shipped JavaScript</h4>
            <span class="badge">183×</span>
          </div>
          <div class="sqwrap">
            <i class="sq c"></i>
            <i class="sq z"></i>
            <div class="sqlab">
              <div class="val z">1.4MB</div>
              <div class="val c">256MB, in 12,021 files</div>
            </div>
          </div>
          <p class="micro">Drawn to scale, by area. The bright square is the entire frontend.</p>
        </div>

        <div class="bcard span2">
          <div class="bhead">
            <h4>launch</h4>
            <span class="badge">21×</span>
          </div>
          <div class="tl">
            <div class="tlrow">
              <span class="tlab">cold, to a window</span>
              <span class="ttrack">
                <i class="stem c" style="width:90.7%"></i><i class="pin c" style="left:90.7%"></i>
                <i class="stem z" style="width:4.2%"></i><i class="pin z" style="left:4.2%"></i>
                <span class="tval z" style="left:5.5%">0.38s</span>
                <span class="tval c" style="left:92%">8.16s</span>
              </span>
            </div>
            <div class="tlrow">
              <span class="tlab">warm, ready to use</span>
              <span class="ttrack">
                <i class="stem c" style="width:73.2%"></i><i class="pin c" style="left:73.2%"></i>
                <i class="stem z" style="width:26.6%"></i><i class="pin z" style="left:26.6%"></i>
                <span class="tval z" style="left:28%">2.39s</span>
                <span class="tval c" style="left:74.5%">6.59s</span>
              </span>
            </div>
            <div class="taxis"><span>0s</span><span>3s</span><span>6s</span><span>9s</span></div>
          </div>
        </div>

        <div class="bcard">
          <div class="bhead">
            <h4>memory</h4>
            <span class="badge">1.9–7.4×</span>
          </div>
          <div class="colwrap">
            <div class="colgroup">
              <div class="colpair">
                <div class="colv"><span class="cval z">354</span><i class="colbar z" style="height:19.6%"></i></div>
                <div class="colv"><span class="cval c">687</span><i class="colbar c" style="height:38.1%"></i></div>
              </div>
              <span class="collab">one project</span>
            </div>
            <div class="colgroup">
              <div class="colpair">
                <div class="colv"><span class="cval z">243</span><i class="colbar z" style="height:13.5%"></i></div>
                <div class="colv"><span class="cval c">1,803</span><i class="colbar c" style="height:100%"></i></div>
              </div>
              <span class="collab">four projects</span>
            </div>
          </div>
          <p class="micro">MB, phys_footprint. Each Cursor project is a window: ~360MB and three processes, linearly. zero’s process count never moves off five.</p>
        </div>

        <div class="bcard">
          <div class="bhead">
            <h4>ships with</h4>
            <span class="badge">∞</span>
          </div>
          <div class="zeroes">
            <div class="zrow">
              <span class="zbig">0</span>
              <div class="zwhat">
                <span class="val z">bundled extensions</span>
                <span class="val c">Cursor: 116</span>
              </div>
              <span class="badge">∞ fewer</span>
            </div>
            <div class="zrow">
              <span class="zbig">0</span>
              <div class="zwhat">
                <span class="val z">bundled runtime — system WebKit</span>
                <span class="val c">Cursor: 259MB of Electron</span>
              </div>
              <span class="badge">∞ less</span>
            </div>
          </div>
        </div>

        <div class="bcard">
          <div class="bhead">
            <h4>idle CPU</h4>
            <span class="badge">2.4×</span>
          </div>
          <div class="duo">
            <div class="drow"><span class="track"><i class="fill z" style="width:41.4%"></i></span><span class="val z">1.10%</span></div>
            <div class="drow"><span class="track"><i class="fill c" style="width:100%"></i></span><span class="val c">2.66%</span></div>
          </div>
          <p class="micro">Of one core, while doing nothing. Doing nothing is a workload now.</p>
        </div>

        <div class="bcard">
          <div class="bhead">
            <h4>terminal frame rate</h4>
            <span class="badge">2.1×</span>
          </div>
          <div class="duo">
            <div class="drow"><span class="track"><i class="fill z" style="width:100%"></i></span><span class="val z">125fps</span></div>
            <div class="drow"><span class="track"><i class="fill c" style="width:47.2%"></i></span><span class="val c">59fps, stock WebView</span></div>
          </div>
          <p class="micro">
            The one graph where longer is better. zero on a ProMotion display against WKWebView’s
            default 60fps clamp — Safari was the control, so the machine was never the limit.
          </p>
        </div>
      </div>

      <aside class="caveat">
        The caveat that matters: Cursor does enormously more — language servers, extensions,
        debugging, an actual AI product. Most of the gap above is that difference priced in bytes and
        milliseconds, not better engineering. We just noticed which part you were using.
        <a href={BENCHMARKS}>Method, caveats, and the scripts to reproduce it →</a>
      </aside>
    </section>

    <section class="features">
      <h2>what’s in it</h2>
      <div class="grid">
        <div class="card">
          <h3><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.tabs} />projects are tabs</h3>
          <p>
            Each keeps its own terminals, sidebar and open files. Switching is a compositor swap —
            everything stays laid out and painted, nothing re-fits when you come back.
          </p>
        </div>
        <div class="card">
          <h3><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.term} />the terminal is the point</h3>
          <p>
            Full window width, splits in any direction, draggable dividers. No title, no bar, no rule —
            buttons appear only when the pointer goes looking for them.
          </p>
        </div>
        <div class="card">
          <h3><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.branch} />worktrees, not branches</h3>
          <p>
            The sidebar lists every worktree with its changes, staging and commit box. Which is the
            shape of the work when several sessions are going at once.
          </p>
        </div>
        <div class="card">
          <h3><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.bars} />bars for what you changed</h3>
          <p>
            Green for added, blue for edited, a red wedge where lines were deleted — in the gutter,
            again beside the scrollbar, and up the file tree, so an edit three folders deep is visible
            without opening anything.
          </p>
        </div>
        <div class="card">
          <h3><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.search} />⌘P, and search in Rust</h3>
          <p>
            Fuzzy go-to-file over what git will admit to, so <code>node_modules</code> never appears.
            Project search runs in-process: 53ms warm on a 6,777-file repo, where ripgrep took 83.
          </p>
        </div>
        <div class="card">
          <h3><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.braces} />143 languages</h3>
          <p>
            The seven zero is written in are compiled in; the rest load the first time you open one, so
            a project with no Ruby in it never pays for the Ruby mode.
          </p>
        </div>
        <div class="card">
          <h3><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.gauge} />120fps in a WebView</h3>
          <p>
            WKWebView clamps rendering to 60fps. Safari turns the clamp off through a private flag, so
            zero flips the same one at startup. This rules out the Mac App Store forever. We’re at
            peace.
          </p>
        </div>
        <div class="card">
          <h3><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.cursor} />⌘-click anything</h3>
          <p>
            A name in the editor opens where it’s defined, through path aliases. A path in the terminal
            opens beside it — <code>file.ts:42</code> lands on the line — and URLs open in your browser.
          </p>
        </div>
        <div class="card">
          <h3><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.restore} />it opens how you left it</h3>
          <p>
            Projects, splits, sidebar, tabs — restored. The shells are new, because they die with the
            app; <code>claude --continue</code> picks the conversation back up, which is the part you
            wanted.
          </p>
        </div>
      </div>
      <div class="card wide">
        <h3><svg class="ic" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" set:html={IC.slash} />what’s not in it</h3>
        <p>
          An extension marketplace. A sign-in. A welcome tour. A release-notes popup. A settings sync
          service. A chat panel you can’t close — claude lives in the terminal, where you put it.
          Network code of any kind: the only thing that ever leaves this Mac is what you were already
          typing into <code>claude</code>. The absence is the feature.
        </p>
      </div>
    </section>

    <section class="platform">
      <p class="phead">Apple Silicon only. macOS 26 only. On purpose.</p>
      <p class="pbody">
        zero is purpose-built for exactly one platform. No Intel branch, no Electron, no compatibility
        ballast for a MacBook from 2017 — and it leans on macOS for everything macOS is already good
        at: the WebView, the transcriber, the fonts. Building for one machine instead of every machine
        is why the whole app is 14MB and why it opens before your finger leaves the trackpad.
        Purpose-built isn’t the fine print here. It’s the trick.
      </p>
    </section>

    <section id="install" class="install">
      <h2>install</h2>
      <div class="brew">
        <code>brew install --cask zero-editor/zero/zero</code>
        <button class="copy" data-copy="brew install --cask zero-editor/zero/zero" aria-label="copy the brew command">copy</button>
      </div>
      <p class="alt">
        Or <a href={DMG}>download the dmg</a><span class="release-extra"></span>
        and drag zero to Applications. Apple Silicon, macOS 26, <code>git</code> — nothing else.
      </p>
      <p class="alt">
        The whole thing is <a href={GITHUB}>open source on GitHub</a> — 17,593 lines of MIT. Read it
        in an afternoon, or <a href={`${GITHUB}#or-build-it`}>build it yourself</a> in about a minute.
      </p>
    </section>

    <footer>
      <div class="foot-row">
        <span class="wordmark">zero</span>
        <div class="foot-links">
          <a href={GITHUB}>github</a>
          <a href="#benchmarks">benchmarks</a>
          <a href={`${GITHUB}/releases`}>releases</a>
          <a href={`${GITHUB}/blob/main/LICENSE`}>mit</a>
        </div>
      </div>
      <p>Made by Lucian and Vid — from Slovenia, with love and a small <code>phys_footprint</code>.</p>
      <p>It’s zero, not Zero. Even at the start of a sentence. Especially there.</p>
      <p>
        This page is one HTML file with no framework in it — about 8KB over the wire, a third of what
        the average one of Cursor’s 12,021 JavaScript files weighs.
      </p>
    </footer>

    <script is:inline>
      // The site's entire JavaScript: ask GitHub what the newest release is,
      // and make the copy buttons copy. If any of it fails, the page has
      // already said everything it needed to.
      (async () => {
        try {
          const r = await fetch('https://api.github.com/repos/zero-editor/zero/releases/latest');
          if (!r.ok) return;
          const rel = await r.json();
          const v = (rel.tag_name || '').replace(/^v/, '');
          const date = rel.published_at
            ? new Date(rel.published_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' })
            : '';
          const dmg = (rel.assets || []).find((a) => a.name === 'zero_aarch64.dmg');
          const size = dmg ? `${(dmg.size / 1048576).toFixed(1)}MB` : '';
          const bits = [v && `v${v}`, date, size].filter(Boolean).join(' · ');
          if (!bits) return;
          for (const el of document.querySelectorAll('.release-extra')) {
            el.textContent = ` — ${bits}`;
          }
        } catch {}
      })();

      for (const btn of document.querySelectorAll('.copy')) {
        btn.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(btn.dataset.copy);
            btn.textContent = 'copied';
            setTimeout(() => (btn.textContent = 'copy'), 1600);
          } catch {}
        });
      }
    </script>
