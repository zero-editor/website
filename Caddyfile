{
	admin off
	persist_config off
}

# Railway injects PORT; 8080 is the fallback for running the image locally.
:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	file_server

	# Astro's hashed assets can be cached forever; the HTML can't.
	header /_astro/* Cache-Control "public, max-age=31536000, immutable"
}
